# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Two trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

[{Makefile,*.mk,*.go}]
indent_style = tab

[*.{py,rs,java,kt,cs}]
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

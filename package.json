{
  "name": "@igorlau/dotagents",
  "version": "1.0.0-dev",
  "description": "Install a curated set of agent skills and rules into Claude Code, Codex, and GitHub Copilot.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorlau/dotagents.git"
  },
  "homepage": "https://github.com/igorlau/dotagents#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "dotagents": "dist/cli.js"
  },
  "files": [
    "dist",
    "content",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-info.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "lint:content": "node scripts/lint-content.ts",
    "check-upstream": "node scripts/check-upstream.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
